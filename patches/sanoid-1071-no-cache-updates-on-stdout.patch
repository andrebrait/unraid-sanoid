 sanoid | 1 -
 1 file changed, 1 deletion(-)

diff --git a/sanoid b/sanoid
index 8e0d1861..ce31f18a 100755
--- a/sanoid
+++ b/sanoid
@@ -1792,7 +1792,6 @@ sub addcachedsnapshots {
