# Source: https://github.com/jimsalterjrs/sanoid/pull/1114 (open, unreleased at time of vendoring; fixes #1118)
# Original commit 5dfb3f20e9b268997351bbe6694fe077db01e037 by Bas Nijholt, vendored unmodified (git format-patch). Apply with: patch -p1

From 5dfb3f20e9b268997351bbe6694fe077db01e037 Mon Sep 17 00:00:00 2001
From: Bas Nijholt <bas@nijho.lt>
Date: Sat, 26 Sep 2026 14:41:20 -0700
Subject: [PATCH] Escape receive resume tokens in send commands

---
 syncoid | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/syncoid b/syncoid
index 34e5a120..5ccf2b7f 100755
--- a/syncoid
+++ b/syncoid
@@ -1106,7 +1106,8 @@ sub syncclone {
 sub syncresume {
 	my ($sourcehost, $sourcefs, $targethost, $targetfs, $receivetoken) = @_;
 
-	my $sendsource = "-t $receivetoken";
+	my $receivetokenescaped = escapeshellparam($receivetoken);
+	my $sendsource = "-t $receivetokenescaped";
 	my $pvsize = getsendsize($sourcehost,"","",$sourceisroot,$receivetoken);
 
 	my $srcname = buildnicename($sourcehost, $sourcefs);
@@ -2137,7 +2138,11 @@ sub getsendsize {
 	# in case of a resumed receive, get the remaining
 	# size based on the resume token
 	if (defined($receivetoken)) {
-		$snaps = "-t $receivetoken";
+		my $receivetokenescaped = escapeshellparam($receivetoken);
+		if ($sourcehost ne '') {
+			$receivetokenescaped = escapeshellparam($receivetokenescaped);
+		}
+		$snaps = "-t $receivetokenescaped";
 	}
 
 	my $sendoptions;
