<FILE Name="&plugin;/packages/sanoid.2.3.0-2.x86_64.tgz">
<URL>&repo;/packages/sanoid.2.3.0-2.x86_64.tgz</URL>
<SHA256>a84d0a7164d41cff1a54a7b5926e7a5956d22140027016cd75f6d496974c9e27</SHA256>
</FILE>

<FILE Run="/bin/bash">
<INLINE>


# Replace the plugin's previous name; its packages are the same and are installed again below.
rm -f /boot/config/plugins/unRAID6-Sanoid.plg /var/log/plugins/unRAID6-Sanoid.plg
rm -rf /boot/config/plugins/unRAID6-Sanoid /usr/local/emhttp/plugins/unRAID6-Sanoid

PACKAGES="
lzop-1.04-x86_64-2_slonly.txz
perl-Capture-Tiny-0.48-x86_64-1ponce.txz
perl-Config-IniFiles-2.82-x86_64-3_slonly.txz
perl-Exporter-Tiny-1.000000-x86_64-1ponce.txz
perl-List-MoreUtils-0.425-x86_64-2_slonly.txz
sanoid.2.3.0-2.x86_64.tgz
"


# Install a package that the plugin manager downloaded and verified above
install_package() {

  local pkg="&plugin;/packages/${1}"

  if [ ! -f "${pkg}" ]; then
    echo "Package '${1}' is missing from &plugin;/packages."
    exit 1
  fi

  if /sbin/installpkg "${pkg}" ; then
    echo ""
  else
    echo install failed
    exit 1
  fi

  #fix for the icon
  chmod 755 &emhttp;/
}

for package in $PACKAGES; do
  install_package $package
done


echo ""
echo "********************************************************************************"
echo "Sanoid installed - you need to manually schedule Sanoid - for example with Cron"
echo "* * * * * TZ=UTC /usr/local/sbin/sanoid --cron"
echo ""
echo "please read the guide @ https://github.com/jimsalterjrs/sanoid"
echo "********************************************************************************"
echo ""

</INLINE>
</FILE>


<!-- PLUGIN REMOVAL SCRIPT -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
echo "+=============================================================================="
echo "| Uninstalling Sanoid"
echo "+=============================================================================="
# Remove plugin related files
rm -rf /usr/local/emhttp/plugins/&name;
rm -rf &plugin;/packages
echo ""
echo "Sanoid plugin uninstalled and will be removed on next reboot "
</INLINE>
</FILE>
</PLUGIN>
